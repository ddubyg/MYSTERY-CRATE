@using MysteryCrate.Models
@using MysteryCrate.Services
@inject CartService CartService
@inject NotificationService NotificationService

<div class="group relative bg-card rounded-xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover flex flex-col overflow-hidden @RarityHelper.GetBorderAccent(Creature.Rarity) @CustomClass">
    <!-- Card Art Header -->
    <a href="/cards/@Creature.Id" class="block relative aspect-[4/3] w-full overflow-hidden bg-gradient-to-br @Creature.ArtColorGradient flex items-center justify-center p-4">
        <!-- Subtle Foil / Sheen Overlay for Mutated Cards -->
        @if (Creature.Mutations.Any())
        {
            <div class="absolute inset-0 prismatic-foil opacity-30 pointer-events-none group-hover:opacity-50 transition-opacity"></div>
        }

        <!-- Center Emoji Artwork -->
        <span class="text-6xl md:text-7xl select-none transition-transform duration-300 group-hover:scale-110 drop-shadow-lg">
            @Creature.EmojiArt
        </span>

        <!-- Badges on Art Overlay -->
        <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5 z-10">
            <RarityBadge Rarity="@Creature.Rarity" />
            @if (Creature.IsOneOfOne)
            {
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider bg-gold-accent text-plum-deep shadow-sm">
                    1 OF 1
                </span>
            }
            else if (!string.IsNullOrEmpty(Creature.SerialNumber))
            {
                <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-plum-deep/80 text-white/90 backdrop-blur-sm">
                    #@Creature.SerialNumber
                </span>
            }
        </div>

        @if (OwnershipCount > 0)
        {
            <div class="absolute top-2.5 right-2.5 z-10">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-plum-deep text-gold-accent border border-gold-accent/40 shadow-sm">
                    Owned ×@OwnershipCount
                </span>
            </div>
        }
    </a>

    <!-- Card Body Content -->
    <div class="p-4 flex-1 flex flex-col justify-between">
        <div>
            <!-- Habitat & Type -->
            <div class="flex items-center justify-between text-[11px] text-ink-muted uppercase tracking-wider mb-1 font-medium">
                <span>@Creature.CreatureType</span>
                <span>@Creature.Habitat</span>
            </div>

            <!-- Creature Name & Title -->
            <a href="/cards/@Creature.Id" class="block group-hover:text-purple-muted transition-colors">
                <h3 class="font-display font-bold text-lg text-ink-primary leading-tight">
                    @Creature.Name
                </h3>
                <p class="text-xs text-ink-muted italic mb-2">
                    @Creature.Title
                </p>
            </a>

            <!-- Mutation Badges -->
            @if (Creature.Mutations.Any())
            {
                <div class="flex flex-wrap gap-1 mb-3">
                    @foreach (var mutation in Creature.Mutations)
                    {
                        <MutationBadge Mutation="@mutation" />
                    }
                </div>
            }
        </div>

        <!-- Footer: Pricing and Actions -->
        <div class="pt-3 border-t border-border-subtle flex items-center justify-between gap-2 mt-auto">
            <PriceDisplay Amount="@Creature.GetValuation()" Label="Valuation" IsShowcase="@Creature.IsFeaturedShowcase" />

            <div class="flex items-center gap-1.5">
                <a href="/cards/@Creature.Id" class="px-3 py-1.5 rounded-lg text-xs font-medium text-plum-secondary bg-purple-light hover:bg-purple-soft transition-colors" title="View card details">
                    Details
                </a>

                @if (Creature.IsAvailableInShop && ShowAddToCart)
                {
                    <button @onclick="AddToCart" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-plum-deep bg-gold-accent hover:bg-gold-hover transition-colors shadow-sm flex items-center gap-1" title="Add to cart">
                        <span>+ Cart</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Creature Creature { get; set; } = null!;

    [Parameter]
    public int OwnershipCount { get; set; } = 0;

    [Parameter]
    public bool ShowAddToCart { get; set; } = true;

    [Parameter]
    public string? CustomClass { get; set; }

    private void AddToCart()
    {
        CartService.AddCreature(Creature);
        NotificationService.ShowToast($"Added {Creature.Name} to cart!");
    }
}

