<div class="flex flex-col items-center justify-center p-12 text-center">
    <div class="relative w-12 h-12 mb-4">
        <div class="absolute inset-0 rounded-full border-2 border-purple-muted/20"></div>
        <div class="absolute inset-0 rounded-full border-2 border-gold-accent border-t-transparent animate-spin"></div>
        <span class="absolute inset-0 flex items-center justify-center text-xs text-gold-accent">✦</span>
    </div>
    <p class="font-display text-sm font-medium text-ink-primary">@Message</p>
    <p class="text-xs text-ink-muted mt-1">Connecting to the Veilbound archives...</p>
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "Unveiling arcane secrets...";
}

